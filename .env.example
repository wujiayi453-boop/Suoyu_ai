# Optional: omit this file to use the full offline data package.
# To use Elasticsearch instead, copy this file as .env and fill in your own connection values.
ES_URL=https://your-elasticsearch-host:9200
ES_API_KEY=your-read-only-api-key
ES_CA_CERT=C:\\path\\to\\http_ca.crt
ES_ARTICLES_INDEX=articles_v2
ES_COMPANIES_INDEX=companies_v2
ES_JOBS_INDEX=jobs_v2
ES_MODELS_INDEX=models_v2
ES_NEWS_INDEX=news_v2
